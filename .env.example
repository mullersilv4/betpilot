DJANGO_SECRET_KEY=troque-essa-chave-em-producao
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=seu-dominio.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.com,http://127.0.0.1,http://localhost

THE_ODDS_API_KEY=your-odds-api-key
ODDSPAPI_API_KEY=your-oddspapi-key

# Email de recuperação de senha. Exemplo SMTP com Gmail/Google Workspace.
# Use senha de app, não a senha normal da conta.
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=seu-email@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=sua-senha-de-app
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_DEFAULT_FROM_EMAIL=Freebetar <seu-email@gmail.com>
DJANGO_SERVER_EMAIL=Freebetar <seu-email@gmail.com>
DJANGO_EMAIL_TIMEOUT=20
FREEBETAR_SITE_URL=https://freebetar.com.br

# Mercado Pago. Use as credenciais de teste primeiro.
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_PUBLIC_KEY=TEST-sua-public-key
MERCADO_PAGO_ACCESS_TOKEN=TEST-seu-access-token
MERCADO_PAGO_WEBHOOK_SECRET=sua-chave-secreta-do-webhook
